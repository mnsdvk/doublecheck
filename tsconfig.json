{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "jsx": "react-jsx",
    "types": ["node"], "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["server", "shared", "host/src", "test", "scripts/*.ts"]
}
